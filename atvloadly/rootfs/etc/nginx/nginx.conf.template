user www-data;
worker_processes auto;
pid /run/atvloadly/nginx.pid;
error_log /dev/stderr warn;
events { worker_connections 1024; }
http {
    include /etc/nginx/mime.types;
    access_log off;
    map $http_upgrade $connection_upgrade {
        default upgrade;
        '' close;
    }
    server {
        listen @INGRESS_PORT@;
        allow 172.30.32.2;
        deny all;
        client_max_body_size 0;
        location / {
            proxy_pass http://127.0.0.1:5533;
            proxy_http_version 1.1;
            proxy_set_header Upgrade $http_upgrade;
            proxy_set_header Connection $connection_upgrade;
            proxy_set_header Accept-Encoding "";
            proxy_request_buffering off;
            proxy_read_timeout 3600s;
            proxy_send_timeout 3600s;
            # Rewritten assets contain this session's ingress prefix.
            proxy_hide_header Cache-Control;
            proxy_hide_header ETag;
            proxy_hide_header Last-Modified;
            add_header Cache-Control "no-store" always;
            sub_filter_types application/javascript text/javascript;
            sub_filter_once off;
            sub_filter 'src="/' 'src="$http_x_ingress_path/';
            sub_filter 'href="/' 'href="$http_x_ingress_path/';
            sub_filter 'href:"/"' 'href:"$http_x_ingress_path/"';
            sub_filter 'baseURL:"/"' 'baseURL:"$http_x_ingress_path/"';
            # shortcut: v0.7.4 Vite loader name; check the frontend assets on upgrades.
            sub_filter 'Nd="/"' 'Nd="$http_x_ingress_path/"';
            sub_filter '"/ws/' '"$http_x_ingress_path/ws/';
            sub_filter '}/ws/' '}$http_x_ingress_path/ws/';
            sub_filter '`/apps/' '`$http_x_ingress_path/apps/';
            sub_filter '"/img/' '"$http_x_ingress_path/img/';
        }
    }
}
